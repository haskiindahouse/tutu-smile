# «Улыбка» — конфигурация сервиса. Скопируйте в .env и заполните.
# .env в git НЕ коммитится (см. .gitignore). Секреты держим только здесь.

# --- LLM (OpenRouter), опционально ---
# Без ключа: умный ввод (текст/голос/чат -> событие) выключен с понятной подсказкой,
# вайб-режим и человеческие карточки деградируют к детерминированным заготовкам.
OPENROUTER_API_KEY=
# Цепочка моделей: первая ответившая побеждает (фолбэк при сбое провайдера).
SMILE_LLM_MODELS=google/gemini-3.6-flash,openai/gpt-5.6-luna,z-ai/glm-5.2

# --- Карта (Mapbox) ---
# Публичный токен, отдаётся на фронт для «карты сбора». Без него карта скрывается.
MAPBOX_TOKEN=

# --- Сервис ---
SMILE_ADDR=:8080
SMILE_MCP_ENDPOINT=https://mcp.tutu.ru/mcp
SMILE_MCP_TIMEOUT=25s
SMILE_MCP_CACHE_TTL=90s
SMILE_MCP_RETRIES=2
SMILE_MAX_CONCURRENCY=4
SMILE_RECHECK_EVERY=150s

# --- Бережливость к MCP (WAF банит агрессивный фан-аут — проверено живьём) ---
SMILE_MCP_MAX_CONCURRENT=4        # потолок одновременных запросов
SMILE_MCP_MIN_INTERVAL=150ms      # зазор между последовательными запросами
SMILE_MCP_BREAKER_FAILS=5         # сколько сетевых отказов подряд открывают breaker
SMILE_MCP_BREAKER_COOLDOWN=60s    # пауза, пока сервер «остывает»
# Прокси-пул (ротация IP): host:port:user:pass или полный URL, через запятую.
SMILE_MCP_PROXIES=
